{
  "name": "ia4dev-jour1-slides",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:jour1": "slidev jour1.md --open",
    "dev:index": "slidev index.md --open",
    "dev:jour2": "slidev jour2.md --open",
    "dev:jour3": "slidev jour3.md --open",
    "dev:index:en": "slidev index.en.md --open",
    "dev:jour1:en": "slidev jour1.en.md --open",
    "build": "slidev build index.md",
    "build:jour1": "slidev build jour1.md --out dist/jour1",
    "build:jour2": "slidev build jour2.md --out dist/jour2",
    "build:jour3": "slidev build jour3.md --out dist/jour3",
    "build:index:en": "slidev build index.en.md --out dist/en",
    "build:jour1:en": "slidev build jour1.en.md --out dist/en/jour1",
    "export:jour1": "slidev export jour1.md --output Jour1.pdf",
    "export:jour2": "slidev export jour2.md --output Jour2.pdf",
    "export:jour3": "slidev export jour3.md --output Jour3.pdf",
    "export:jour1:en": "slidev export jour1.en.md --output Day1.pdf",
    "export:png:jour1": "slidev export jour1.md --format png --output export-png",
    "export:png:jour2": "slidev export jour2.md --format png --output export-png-jour2",
    "export:png:jour3": "slidev export jour3.md --format png --output export-png-jour3",
    "export:png:jour1:en": "slidev export jour1.en.md --format png --output export-png-jour1-en",
    "check:translations": "node scripts/check-translations.mjs",
    "build:all": "node scripts/build-all.mjs",
    "preview": "node scripts/build-all.mjs /slides/ && node scripts/preview.mjs"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/lexend": "^5.3.0",
    "@fontsource/instrument-serif": "^5.2.9",
    "@slidev/cli": "^51.7.1",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "playwright-chromium": "^1.63.0"
  },
  "overrides": {
    "image-size": "^2.0.3"
  }
}
